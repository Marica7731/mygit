{
  "name": "youtube-ranking-pages",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Pages static ranking pages for YouTube 歌枠 / 弾き語り search results.",
  "scripts": {
    "check": "node scripts/check-js-syntax.js && node scripts/write-ranking-groups.js --check",
    "update": "node scripts/update-youtube-ranking.js",
    "snapshot": "node scripts/archive-live-snapshot.js",
    "validate:snapshots": "node scripts/validate-live-snapshots.js",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  },
  "engines": {
    "node": ">=20"
  }
}
